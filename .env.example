# Copiar a .env y completar. NUNCA commitear .env.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # pública, solo lectura gracias a RLS
SUPABASE_SERVICE_ROLE_KEY=            # SOLO backend/pipeline. Nunca en el frontend.

# Frontend (apps/web) — variable de SERVIDOR, sin prefijo NEXT_PUBLIC_
# Valores: reales (demo: los 100+ repos reales que indexa el asistente, feature 005) | sintetico | fixtures (SOLO pruebas: Playwright
# la fija por su cuenta; jamás en producción ni en la demo) | backend (API REST de backend/, ver README) | supabase (fuera del MVP)
# En producción es obligatoria: el código no tiene valor por defecto. No es un secreto.
CATALOG_SOURCE=reales
# Origen del backend para CATALOG_SOURCE=backend (variable de SERVIDOR, sin NEXT_PUBLIC_). Ej.: http://127.0.0.1:8000
# Sin valor por defecto. El frontend solo lee endpoints públicos: NO lleva token en runtime (P3).
BACKEND_URL=

# Solo para scripts/sembrar-backend.mjs y para el backend (operación, nunca en runtime del frontend).
# Generá una propia (ej. `openssl rand -hex 32`). No la escribas en ningún archivo commiteado.
ADMIN_API_KEY=

# GitHub API (pipeline y `npm run ingesta` de apps/web, feature 005) — token fine-grained de solo lectura, sin scopes.
# Solo por entorno; la ingesta nunca lo escribe ni lo muestra en el log.
GITHUB_TOKEN=
# Modelo de Ollama para generar las ideas de integración de la ingesta (por defecto llama3.1:8b).
INGESTA_MODELO_IDEAS=

# LLM (backend/pipeline)
LLM_API_KEY=
LLM_MODEL=

# Asistente RAG (apps/web, feature 002) — variables de SERVIDOR, sin NEXT_PUBLIC_
# URL de Ollama local (http/https, sin credenciales). Fuera de producción, por defecto http://localhost:11434.
OLLAMA_URL=
# Solo red-team (scripts/redteam.mjs): 1 desactiva los guardrails del asistente. Se IGNORA en producción.
REDTEAM_SIN_GUARDRAILS=

# Persistencia (feature 006) — Postgres + pgvector. Solo por entorno; nunca en un archivo commiteado.
# Contraseña del superusuario del contenedor (solo para levantar la base; el backend NO la usa).
POSTGRES_PASSWORD=
# Contraseña del rol de login del backend (miembro de service_role). Generá una propia (openssl rand -hex 24).
BACKEND_DB_PASSWORD=
# DSN del backend: postgresql://backend_service:<BACKEND_DB_PASSWORD>@127.0.0.1:5432/openbridge. Sin esto: store en memoria.
DATABASE_URL=
# Re-ingesta programada del backend (horas entre corridas, ej. 24). Vacío o 0 = apagada.
INGEST_SCHEDULE_HOURS=
