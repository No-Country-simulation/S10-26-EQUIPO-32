{
  "name": "openbridge-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend del catálogo de OpenBridge (feature 001)",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:backend": "playwright test -c playwright.backend.config.ts",
    "check:deps": "node scripts/verificar-dependencias.mjs",
    "check:invisibles": "node scripts/verificar-invisibles.mjs",
    "embeddings": "node --env-file-if-exists=.env scripts/generar-embeddings.mjs",
    "redteam": "node --env-file-if-exists=.env scripts/redteam.mjs",
    "sembrar:backend": "node scripts/sembrar-backend.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
